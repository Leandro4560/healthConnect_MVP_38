server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Proxy API requests to backend (BACKEND_URL must include scheme and host, e.g. https://api.example.com)
  location /api/ {
    # proxy_pass must end with a slash to preserve the path after /api/
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Original-URI $request_uri;
    # increase timeouts for proxied requests (useful for long operations)
    proxy_connect_timeout 60s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
  }

  # Serve static files and fallback to index.html for SPA
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Prevent internal redirect loops: serve index.html directly when requested
  location = /index.html {
    try_files /index.html =404;
  }

  # Optional: serve env.js directly (already in /usr/share/nginx/html)
  location = /env.js {
    add_header Cache-Control "no-store";
  }

  error_log /var/log/nginx/error.log info;
  access_log /var/log/nginx/access.log;
}
